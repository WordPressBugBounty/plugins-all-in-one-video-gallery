#: premium/admin/automations.php:1032
msgid ""
"Ready to go?<br><br>Click <strong>Publish & Import</strong> to begin "
"importing and schedule future batches.<br><br>Once the import starts, this "
"button changes to <strong>Import Next Batch</strong>. You can click it "
"anytime to manually trigger the next batch ahead of schedule."
